# Stellar Network Configuration
# Deployer identity is managed via `stellar keys` CLI (no private key needed in env)

# Pinata IPFS Configuration (get from https://app.pinata.cloud/keys)
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_here

# Stellar Soroban RPC URL (default: Stellar testnet)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon URL
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar Network (TESTNET or PUBLIC)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
